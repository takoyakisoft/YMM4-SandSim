<data name="ScreenSize_Name" xml:space="preserve"><value>Screen Size</value></data>
<data name="ScreenSize_Desc" xml:space="preserve"><value>Runs the simulation at the screen size.</value></data>
<data name="SourceMode_Name" xml:space="preserve"><value>Input Mode</value></data>
<data name="SourceMode_Desc" xml:space="preserve"><value>Selects initial-frame capture, continuous filling of empty cells, or restamping selected positions every frame. XPBD solids use one slot per input cell and are not duplicated by continuous input.</value></data>
<data name="ParticleSize_Name" xml:space="preserve"><value>Particle Size</value></data>
<data name="ParticleSize_Desc" xml:space="preserve"><value>Sets the pixels represented by one cell. Larger values are faster and use less GPU memory. 4 px is recommended. At 1080p/1 px, CA uses about 32 MiB and all features use about 150 MiB. The state budget is about 304 MiB.</value></data>
<data name="MaterialAssignment_Name" xml:space="preserve"><value>Material Assignment</value></data>
<data name="MaterialAssignment_Desc" xml:space="preserve"><value>Classifies the source into 55 colors mapped one-to-one to physical materials, or converts it to one material.</value></data>
<data name="SingleMaterial_Name" xml:space="preserve"><value>Single Material</value></data>
<data name="SingleMaterial_Desc" xml:space="preserve"><value>Selects the material used by Single Material assignment.</value></data>
<data name="ColorMode_Name" xml:space="preserve"><value>Display Color</value></data>
<data name="ColorMode_Desc" xml:space="preserve"><value>Displays either the original source colors or the classified material palette.</value></data>
<data name="Iterations_Name" xml:space="preserve"><value>Update Count</value></data>
<data name="Iterations_Desc" xml:space="preserve"><value>Sets simulation updates per frame. Higher values advance faster and increase GPU load.</value></data>
<data name="Warmup_Name" xml:space="preserve"><value>Initial Update Count</value></data>
<data name="Warmup_Desc" xml:space="preserve"><value>Sets additional updates immediately after initialization. Higher values increase first-frame GPU load.</value></data>
<data name="Spread_Name" xml:space="preserve"><value>Fluidity</value></data>
<data name="Spread_Desc" xml:space="preserve"><value>Controls diagonal powder movement and horizontal spreading of liquids and gases.</value></data>
<data name="ReactionStrength_Name" xml:space="preserve"><value>Reaction Strength</value></data>
<data name="ReactionStrength_Desc" xml:space="preserve"><value>Sets combustion, evaporation, dissolution, corrosion, smoke and other reactions. 100% is standard; 0% stops material reactions.</value></data>
<data name="SolidMode_Name" xml:space="preserve"><value>Method</value></data>
<data name="SolidMode_Desc" xml:space="preserve"><value>Moves fixed materials to a GPU XPBD grid for material-specific mass</value></data>
<data name="Gravity_Name" xml:space="preserve"><value>Gravity</value></data>
<data name="Gravity_Desc" xml:space="preserve"><value>Sets gravity applied to XPBD solids. 100% is standard. Buoyancy is also applied in liquids according to material density.</value></data>
<data name="Stiffness_Name" xml:space="preserve"><value>Stiffness</value></data>
<data name="Stiffness_Desc" xml:space="preserve"><value>Sets material stiffness. 100% is standard; higher values preserve shape more strongly.</value></data>
<data name="BreakStrength_Name" xml:space="preserve"><value>Fracture Strength</value></data>
<data name="BreakStrength_Desc" xml:space="preserve"><value>Sets material resistance to fracture. 100% is standard; higher values make breaking and tearing less likely.</value></data>
<data name="SolverIterations_Name" xml:space="preserve"><value>Solver Iterations</value></data>
<data name="SolverIterations_Desc" xml:space="preserve"><value>Sets XPBD solver iterations. Higher values stabilize stiff materials and increase GPU load.</value></data>
<data name="ExplosionController_Name" xml:space="preserve"><value>Control Points</value></data>
<data name="ExplosionController_Desc" xml:space="preserve"><value>Shows explosion center and radius control points in the preview. Drag the center to move it and the right point to change radius.</value></data>
<data name="ExplosionX_Name" xml:space="preserve"><value>Center X</value></data>
<data name="ExplosionX_Desc" xml:space="preserve"><value>Sets the explosion center X coordinate relative to the item center.</value></data>
<data name="ExplosionY_Name" xml:space="preserve"><value>Center Y</value></data>
<data name="ExplosionY_Desc" xml:space="preserve"><value>Sets the explosion center Y coordinate relative to the item center.</value></data>
<data name="ExplosionFrame_Name" xml:space="preserve"><value>Trigger Frame</value></data>
<data name="ExplosionFrame_Desc" xml:space="preserve"><value>Sets the frame after the effect starts at which the explosion triggers. Re-evaluating the same frame does not trigger it twice.</value></data>
<data name="ExplosionStrength_Name" xml:space="preserve"><value>Strength</value></data>
<data name="ExplosionStrength_Desc" xml:space="preserve"><value>Sets explosion pressure strength. 100% is standard; 0% disables pressure waves</value></data>
<data name="ExplosionRadius_Name" xml:space="preserve"><value>Radius</value></data>
<data name="ExplosionRadius_Desc" xml:space="preserve"><value>Sets the approximate pressure-wave radius in cells. Pressure propagates on each update as a shock wave.</value></data>
<data name="LightingStrength_Name" xml:space="preserve"><value>Strength</value></data>
<data name="LightingStrength_Desc" xml:space="preserve"><value>Sets light strength from fire, embers, lava, sea lanterns and explosions. 100% is standard; 0% disables lighting.</value></data>
<data name="LightingRadius_Name" xml:space="preserve"><value>Radius</value></data>
<data name="LightingRadius_Desc" xml:space="preserve"><value>Sets the lighting radius in cells. Higher values illuminate farther and increase GPU load.</value></data>
<data name="AmbientLight_Name" xml:space="preserve"><value>Brightness</value></data>
<data name="AmbientLight_Desc" xml:space="preserve"><value>Sets brightness in unlit areas. 100% preserves source brightness; lower values create darker areas.</value></data>
<data name="ShadowStrength_Name" xml:space="preserve"><value>Shadow Strength</value></data>
<data name="ShadowStrength_Desc" xml:space="preserve"><value>Sets how strongly materials block light. At 0% light passes through; at 100% material shadows are strongest.</value></data>
<data name="MaskMode_Name" xml:space="preserve"><value>Extraction Method</value></data>
<data name="MaskMode_Desc" xml:space="preserve"><value>Selects how pixels are chosen for conversion into materials.</value></data>
<data name="AlphaThreshold_Name" xml:space="preserve"><value>Opacity Threshold</value></data>
<data name="AlphaThreshold_Desc" xml:space="preserve"><value>Converts pixels whose opacity is at or above this value.</value></data>
<data name="LuminanceThreshold_Name" xml:space="preserve"><value>Luminance Threshold</value></data>
<data name="LuminanceThreshold_Desc" xml:space="preserve"><value>Converts pixels whose luminance is at or above this value.</value></data>
<data name="ColorMode_MaterialPalette" xml:space="preserve"><value>Material Palette</value></data>
<data name="ColorMode_PreserveInput" xml:space="preserve"><value>Preserve Input Colors</value></data>
<data name="Assignment_ClosestColor" xml:space="preserve"><value>Auto-detect from 55 colors (one material per color)</value></data>
<data name="Assignment_SingleMaterial" xml:space="preserve"><value>Single Material</value></data>
<data name="ParticleSize_One" xml:space="preserve"><value>1 px (highest detail / high load)</value></data>
<data name="ParticleSize_Two" xml:space="preserve"><value>2 px (high detail)</value></data>
<data name="ParticleSize_Three" xml:space="preserve"><value>3 px (detailed / medium load)</value></data>
<data name="ParticleSize_Four" xml:space="preserve"><value>4 px (recommended)</value></data>
<data name="ParticleSize_Six" xml:space="preserve"><value>6 px (lightweight)</value></data>
<data name="ParticleSize_Eight" xml:space="preserve"><value>8 px (fastest)</value></data>
<data name="SolidMode_Disabled" xml:space="preserve"><value>Disabled (fixed materials remain still)</value></data>
